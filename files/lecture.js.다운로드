function popCwin( url, name, w, h, scroll) {


  var wl = (window.screen.width/2) - ((w/2) + 10);
  var wt = (window.screen.height/2) - ((h/2) + 50);

  var option = "height="+h+",width="+w+",left="+wl+",top="+wt+",screenX="+wl+",screenY="+wt+",scrollbars="+scroll + ", status=yes";

  commonPopWin = window.open( url, name, option );
  commonPopWin.focus();
}

function callhtml(turl,w,h){
	
	if(turl.indexOf('http://') < 0 ){
		var url = turl;
	}else{
		tturl = turl.replace('http://',''); 
		var ttturl =encodeURI(tturl);
		var url = 'http://'+ttturl;

		//20201125 추가 인코딩
		var arrqry = url.split("?");
		url= arrqry[0] + "?" + arrqry[1].replace(/\+/g,"%2B").replace(/\//g,"%2F");
	}
	var wl = (window.screen.width/2) - ((1000/2) + 10);
	var wt = (window.screen.height/2) - ((590/2) + 50);
	if(w == 0 || w == null) w = 1000;
	if(h == 0 || h == null) h = 800;
	var popupOptions = "left="+wl+",top="+wt+",width="+w+",height="+h+",menubar=no,toolbar=no,location=no,status=no,scrollbars=yes";

	authwin=window.open(url,"study",popupOptions);
	authwin.focus();
}

